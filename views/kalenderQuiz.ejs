<%- include("./partials/head") %>

<body>

    <h1><%= luke.tittel %></h1>
    <p>Dette er luke nummer <%= luke.nr %></p>

    <form action="/luke/<%= luke.nr %>/svar" method="POST">

        <% luke.blokker.forEach((blokk, index) => { %>

            <% if (blokk.type === "tekst") { %>

                <p><%= blokk.tekst %></p>

            <% } else if (blokk.type === "video") { %>

                <iframe
                    src="<%= blokk.url %>"
                    allowfullscreen>
                </iframe>

            <% } else if (blokk.type === "bilde") { %>

                <img
                    src="<%= blokk.url %>"
                    alt="Bilde for luke <%= luke.nr %>"
                >

            <% } %>

            <% if (dag > luke.nr) { %>
                <h1>Vinner av denne dagen er ...</h1>
            <% } %>
            
            <input type="hidden" name="blokkIndex" value="<%= index %>">
        <% }) %>

        <input type="text" name="svar" placeholder="Svaret ditt ..." required>

        <button type="submit">Send inn svar</button>

    </form>

</body>