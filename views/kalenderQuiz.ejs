<%- include("./partials/head.ejs") %>
<body>
    <%- include("./partials/nav.ejs") %>

    <main class="quizContainer">

        <section class="quizCard">

            <h1>Luke <%= luke.nr %></h1>
            <h2><%= luke.question %></h2>
            
            <% if (typeof svar === "undefined" || svar === null) { %>
                <form action="/luke/<%= luke.nr %>/svar" method="POST">


                    <% if (luke.type.includes("multiple_choice")) { %>

                        <div class="alternativer">

                            <% if (luke.options && luke.options.length > 0) { %>

                                <% luke.options.forEach((option) => { %>

                                    <label class="alternativ">

                                        <input
                                            type="radio"
                                            name="svar"
                                            value="<%= option %>"
                                            required
                                        >

                                        <span><%= option %></span>

                                    </label>

                                <% }) %>

                            <% } else { %>

                                <p>Ingen svaralternativer ble funnet.</p>

                            <% } %>

                        </div>

                    <% } else if (luke.type.includes("open")) { %>

                        <div class="openSvar">

                            <input
                                type="text"
                                name="svar"
                                placeholder="Skriv svaret ditt..."
                                required
                                autocomplete="off"
                            >

                        </div>

                    <% } else if (luke.type.includes("video")) { %>

                        <div class="videoSvar">

                            <% if (luke.video_url) { %>

                                <div class="videoContainer">

                                    <iframe
                                        src="<%= luke.video_url.replace('watch?v=', 'embed/') %>"
                                        title="Quizvideo"
                                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                        allowfullscreen>
                                    </iframe>

                                </div>

                            <% } %>

                            <input
                                type="text"
                                name="svar"
                                placeholder="Hva er svaret?"
                                required
                                autocomplete="off"
                            >

                        </div>

                    <% } else { %>

                        <p>Fant ikke en gyldig spørsmålstype.</p>

                    <% } %>

                    <button type="submit" class="sendSvarKnapp">
                        Send inn svar
                    </button>

                    
                    
                </form>
            <% } else { %>
                <p>Du svarte: <span><%= svar %></span></p>
            <% } %>
        </section>

    </main>

</body>