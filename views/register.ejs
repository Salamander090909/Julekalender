<%- include("./partials/head.ejs") %>
<script src="https://app.embed.im/snow.js" defer></script>
<body class="registerBody">
    <%- include("./partials/nav.ejs") %>
    <div class="wrapper">
        <form action="" method="post" novalidate>

            <% if(typeof fraLuke !== "undefined" && fraLuke) { %>
                <h1>Registrer deg for å åpne luken</h1>
            <% }else{ %>
                <h1>Registrer deg</h1>
            <% } %>
           

            <label for="email"></label>
            <input type="email" id="email" name="email" pattern="[^@\s]+@afk\.no" placeholder="navn@afk.no" required />
            
            <p class="feil" id="emailFeil" hidden></p>
            
            <% if (typeof error !== "undefined" && error) { %>
                <p class="feil"><%= error %></p>
            <% } %>

            <button class="registerBtn">Registrer Deg</button>
            <p>NB! Bruk en gyldig afk epost for å mota premie</p>
        </form>

    </div>
</body>
</html>