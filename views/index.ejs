<%- include("./partials/head.ejs") %>
<script src="https://app.embed.im/snow.js" defer></script>
<body>
    <%- include("./partials/nav.ejs") %>
    <main class="indexMain">
        <section class="velkommenCard">
            <h1>God Jul</h1>

            <h3>Slik vinner du</h3>
            <ul>
                <li>Logg inn med afk epost</li>
                <li>Svar riktig på spørsmålene i kalenderen</li>
                <li>Vær med i trekningen! Ny vinner hver dag</li>
            </ul>
            <p>Lykke til og god jul!</p>
        </section>

        <section class="kalenderBox">
            <% luker.forEach(luke => {
                let tilstand = luke.nr < dag ? 'åpnet'
                            : luke.nr === dag ? 'i-dag'
                            : 'lukket';
            %>
                <a href="<%= tilstand === 'lukket' ? '#' : '/luke/' + luke.nr %>"
                class="luke <%= luke.klasse %> luke-<%= tilstand %>">
                    <span class="door"><%= luke.nr %></span>
                </a>
            <% }) %>
        </section>

    </main>
</body>
</html>