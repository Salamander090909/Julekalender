<%- include("./partials/head.ejs") %>
<script src="https://app.embed.im/snow.js" defer></script>
<body>
    <%- include("./partials/nav.ejs") %>
    <main>
        <section class="velkommenCard">
            <div class="top">
                <h1>God Jul</h1>
                <p><%= new Date().getDate() %>. Desember</p>
            </div>
            <p>Åpne dagens luke og vinn premie!</p>
        </section>

        <section class="kalenderBox">
            <% luker.forEach(luke => {
                let tilstand = luke.nr < dag ? 'åpnet'
                            : luke.nr === dag ? 'i-dag'
                            : 'lukket';
            %>
                <a href="<%= tilstand === 'lukket' || tilstand === 'åpnet' ? '#' : '/luke/' + luke.nr %>"
                class="luke <%= luke.klasse %> luke-<%= tilstand %>">
                    <span class="door"><%= luke.nr %></span>
                </a>
            <% }) %>
        </section>

    </main>
</body>
</html>